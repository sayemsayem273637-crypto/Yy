local P, RS, UIS = game:GetService("Players"), game:GetService("RunService"), game:GetService("UserInputService")
local me, cam = P.LocalPlayer, workspace.CurrentCamera
local on, rand, smooth, target = false, false, 0.5, nil

local function new(c, props, parent)
	local i = Instance.new(c)
	for k, v in props do i[k] = v end
	i.Parent = parent
	return i
end

local function outline(i, r, t)
	new("UICorner", {CornerRadius = UDim.new(0, r)}, i)
	new("UIStroke", {Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, i)
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function isMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

