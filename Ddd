-- ===== Dragging =====
local full = false
local function draggable(handles, obj, canDrag)
	local d, moved, start, startPos = false, false, nil, nil
	for _, h in handles do
		h.InputBegan:Connect(function(i)
			if isPress(i) and (not canDrag or canDrag()) then
				d, moved, start, startPos = true, false, i.Position, obj.Position
			end
		end)
	end
	UIS.InputChanged:Connect(function(i)
		if d and isMove(i) then
			local delta = i.Position - start
			if delta.Magnitude > 5 then moved = true end
			obj.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if isPress(i) then d = false end
	end)
	return function() return moved end
end

draggable({bar, title}, win, function() return not full end)
local iconMoved = draggable({icon}, icon)

icon.Activated:Connect(function()
	if not iconMoved() then win.Visible = not win.Visible end
end)
closeBtn.Activated:Connect(function() win.Visible = false end)

local savedPos
fullBtn.Activated:Connect(function()
	full = not full
	if full then
		savedPos = win.Position
		win.Size, win.Position = UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0)
	else
		win.Size, win.Position = NORMAL_SIZE, savedPos
	end
	fullBtn.Text = full and "SMALL" or "FULL"
end)

-- ===== Targeting =====
local function valid(p)
	local h = p and p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	return h and h.Health > 0 and p.Character:FindFirstChild("Head") ~= nil
end

local function dist(p) return (p.Character.Head.Position - cam.CFrame.Position).Magnitude end

local function pick()
	local list = {}
	for _, p in P:GetPlayers() do
		if p ~= me and valid(p) then table.insert(list, p) end
	end
	if #list == 0 then return nil end
	if rand then return list[math.random(#list)] end
	table.sort(list, function(a, b) return dist(a) < dist(b) end)
	return list[1]
end

local function set(state)
	on, target = state, nil
	toggle.Text = (on and "ON" or "OFF") .. " [Q]"
	toggle.BackgroundColor3 = on and Color3.fromRGB(60, 200, 90) or Color3.fromRGB(235, 70, 70)
	if not on then tl.Text = "No target" end
end

toggle.Activated:Connect(function() set(not on) end)
UIS.InputBegan:Connect(function(i, gp)
	if not gp and i.KeyCode == Enum.KeyCode.Q then set(not on) end
end)
mode.Activated:Connect(function()
	rand, target = not rand, nil
	mode.Text = "Mode: " .. (rand and "Random" or "Closest")
end)

-- ===== Slider =====
local sliding = false
local function slide(x)
	local r = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	smooth = math.max(0.05, r)
	fill.Size = UDim2.new(r, 0, 1, 0)
	sl.Text = "Smoothness " .. math.floor(r * 100) .. "%"
end
track.InputBegan:Connect(function(i)
	if isPress(i) then sliding = true slide(i.Position.X) end
end)
UIS.InputChanged:Connect(function(i)
	if sliding and isMove(i) then slide(i.Position.X) end
end)
UIS.InputEnded:Connect(function(i)
	if isPress(i) then sliding = false end
end)

-- ===== Aim loop =====
RS:BindToRenderStep("AimLock", Enum.RenderPriority.Camera.Value + 1, function()
	if not on then return end
	if not valid(target) then target = pick() end
	if valid(target) then
		tl.Text = "🎯 " .. target.Name
		cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.Character.Head.Position), smooth)
	else
		tl.Text = "No target"
	end
end)
