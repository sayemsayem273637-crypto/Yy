--// ============================================================
--//  Targeting logic
--// ============================================================
local function alive(p)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return c ~= nil and h ~= nil and r ~= nil and h.Health > 0
end

local function partOf(c)
	if CFG.TargetPart == "Head" then
		return c:FindFirstChild("Head")
	end
	return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function visible(part, char)
	rayParams.FilterDescendantsInstances = {lp.Character, char}
	local origin = cam.CFrame.Position
	return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

local function candidates()
	local list = {}
	local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return list end
	local center = cam.ViewportSize / 2

	for _, p in Players:GetPlayers() do
		if p ~= lp and alive(p) and not (CFG.TeamCheck and lp.Team and p.Team == lp.Team) then
			local part = partOf(p.Character)
			if part then
				local dist = (part.Position - myRoot.Position).Magnitude
				if dist <= CFG.MaxDist then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					local inRange = CFG.Mode == "Closest" or (onScreen and screenDist <= CFG.FOV)
					if inRange and (not CFG.WallCheck or visible(part, p.Character)) then
						table.insert(list, {
							p = p,
							score = CFG.Mode == "Closest" and dist or screenDist,
						})
					end
				end
			end
		end
	end

	table.sort(list, function(a, b) return a.score < b.score end)
	return list
end

local function makeVisuals()
	if not target or not target.Character then return end
	if CFG.Highlight then
		hl = new("Highlight", {
			FillColor = T.Accent2,
			OutlineColor = Color3.new(1, 1, 1),
			FillTransparency = 0.55,
			OutlineTransparency = 0,
			DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
		}, target.Character)
	end
	local head = target.Character:FindFirstChild("Head")
	if head then
		tag = new("BillboardGui", {
			Size = UDim2.fromOffset(150, 28),
			StudsOffset = Vector3.new(0, 2.5, 0),
			AlwaysOnTop = true,
			Adornee = head,
		}, head)
		local l = new("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = T.Bg,
			BackgroundTransparency = 0.2,
			Text = "🎯 " .. target.DisplayName,
			TextColor3 = T.Text,
			Font = T.Title,
			TextSize = 16,
		}, tag)
		round(l, 10)
		stroke(l, T.Accent2, 2)
	end
end

setTarget = function(p)
	if hl then hl:Destroy() hl = nil end
	if tag then tag:Destroy() tag = nil end
	target = p
	makeVisuals()
end

-- step: nil = best target, 1 = next, -1 = previous
pick = function(step)
	local list = candidates()
	if #list == 0 then
		setTarget(nil)
		return
	end
	local idx = 1
	if step then
		for n, v in list do
			if v.p == target then
				idx = (n - 1 + step) % #list + 1
				break
			end
		end
	end
	setTarget(list[idx].p)
end

setEnabled = function(on)
	CFG.Enabled = on
	if on then pick() else setTarget(nil) end
	if sync.Enabled then sync.Enabled() end
	notify(on and "Lock ON 🎯" or "Lock OFF")
end

local function switch(step)
	if not CFG.Enabled then
		notify("Turn lock on first")
		return
	end
	pick(step)
	notify(target and ("Target: " .. target.DisplayName) or "No targets")
end

