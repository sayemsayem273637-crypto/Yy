local function slider(label, key, min, max, decimals)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 52),
		BackgroundColor3 = T.Panel,
	}, scroll)
	round(row, 10)
	local lbl = new("TextLabel", {
		Position = UDim2.fromOffset(12, 4),
		Size = UDim2.new(1, -24, 0, 20),
		BackgroundTransparency = 1,
		TextColor3 = T.Text,
		Font = T.Body,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local hit = new("Frame", {
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 18),
		BackgroundTransparency = 1,
	}, row)
	local track = new("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = T.Off,
	}, hit)
	round(track, 4)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = T.Accent,
		BorderSizePixel = 0,
	}, track)
	round(fill, 4)
	new("UIGradient", {Color = ColorSequence.new(T.Accent, T.Accent2)}, fill)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = T.Text,
	}, track)
	round(knob, 8)

	local function set(v)
		v = math.clamp(v, min, max)
		local m = 10 ^ decimals
		v = math.floor(v * m + 0.5) / m
		CFG[key] = v
		local a = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		lbl.Text = label .. ": " .. v
	end
	local function fromX(x)
		set(min + (max - min) * math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1))
	end

	local dragging = false
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging = true
			fromX(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and isMove(i) then fromX(i.Position.X) end
	end)
	UIS.InputEnded:Connect(function(i)
		if isPress(i) then dragging = false end
	end)
	set(CFG[key])
end

