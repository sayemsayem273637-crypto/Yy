--// ============================================================
--//  Input
--// ============================================================
on(UIS.InputBegan, function(i, gp)
	if gp then return end
	local k = i.KeyCode
	if k == CFG.ToggleKey then
		setEnabled(not CFG.Enabled)
	elseif k == CFG.NextKey then
		switch(1)
	elseif k == CFG.PrevKey then
		switch(-1)
	elseif k == CFG.HideKey then
		main.Visible = not main.Visible
	end
end)

--// ============================================================
--//  Status card + FOV refresh (10x per second)
--// ============================================================
local acc = 0
on(RS.Heartbeat, function(dt)
	acc += dt
	if acc < 0.1 then return end
	acc = 0

	fov.Visible = CFG.ShowFOV and CFG.Mode == "Crosshair"
	fov.Size = UDim2.fromOffset(CFG.FOV * 2, CFG.FOV * 2)

	if target and alive(target) then
		local h = target.Character:FindFirstChildOfClass("Humanoid")
		local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		local root = target.Character:FindFirstChild("HumanoidRootPart")
		local ratio = math.clamp(h.Health / h.MaxHealth, 0, 1)

		nameLbl.Text = "🎯 " .. target.DisplayName
		tween(hpFill, 0.1, {
			Size = UDim2.fromScale(ratio, 1),
			BackgroundColor3 = T.Red:Lerp(T.On, ratio),
		})
		if myRoot and root then
			distLbl.Text = string.format(
				"%d studs  •  %d HP",
				math.floor((root.Position - myRoot.Position).Magnitude),
				math.floor(h.Health)
			)
		end
	else
		nameLbl.Text = CFG.Enabled and "Searching..." or "No target"
		hpFill.Size = UDim2.fromScale(0, 1)
		distLbl.Text = "--"
	end
end)

--// ============================================================
--//  Camera lock (runs right after the default camera)
--// ============================================================
local lastScan = 0

pcall(function() RS:UnbindFromRenderStep("AimLockPro") end)
RS:BindToRenderStep("AimLockPro", Enum.RenderPriority.Camera.Value + 1, function()
	-- pulsing highlight
	if hl then
		hl.FillColor = T.Accent:Lerp(T.Accent2, (math.sin(os.clock() * 4) + 1) / 2)
	end

	if not CFG.Enabled then return end

	-- target lost / dead / out of range / now a teammate? find a new one (throttled)
	if not valid(target) then
		if os.clock() - lastScan < 0.25 then return end
		lastScan = os.clock()
		if CFG.AutoRetarget then
			pick()
		else
			setEnabled(false)
		end
		if not target then return end
	end

	local char = target.Character
	local part = char and partOf(char)
	if not part then return end

	-- wall check: target hidden behind a wall -> don't track, look for a visible one
	if CFG.WallCheck and not visible(char) then
		if CFG.AutoRetarget and os.clock() - lastScan >= 0.25 then
			lastScan = os.clock()
			pick()
		end
		return
	end

	local pos = part.Position
	if CFG.Prediction then
		pos += part.AssemblyLinearVelocity * CFG.PredictAmt
	end

	cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, pos), CFG.Smooth)
end)

--// Cleanup hook so a respawned copy of this script never doubles up
_G.AimLockProCleanup = function()
	for _, c in conns do
		c:Disconnect()
	end
	pcall(function() RS:UnbindFromRenderStep("AimLockPro") end)
	if hl then hl:Destroy() end
	if tag then tag:Destroy() end
	gui:Destroy()
end

