	end
end

setTarget = function(p)
	if hl then hl:Destroy() hl = nil end
	if tag then tag:Destroy() tag = nil end
	target = p
	makeVisuals()
end

-- step: nil = best target, 1 = next, -1 = previous
pick = function(step)
	local list = candidates()
	if #list == 0 then
		setTarget(nil)
		return
	end
	local idx = 1
	if step then
		for n, v in list do
			if v.p == target then
				idx = (n - 1 + step) % #list + 1
				break
			end
		end
	end
	setTarget(list[idx].p)
end

setEnabled = function(isOn)
	CFG.Enabled = isOn
	if isOn then pick() else setTarget(nil) end
	if sync.Enabled then sync.Enabled() end
	notify(isOn and "Lock ON 🎯" or "Lock OFF")
end

local function switch(step)
	if not CFG.Enabled then
		notify("Turn lock on first")
		return
	end
	pick(step)
	notify(target and ("Target: " .. target.DisplayName) or "No targets")
end

