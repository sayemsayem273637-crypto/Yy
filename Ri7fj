--// ============================================================
--//  Targeting logic
--// ============================================================
local function alive(p)
	local c = p.Character
	local h = c and c:FindFirstChildOfClass("Humanoid")
	local r = c and c:FindFirstChild("HumanoidRootPart")
	return c ~= nil and h ~= nil and r ~= nil and h.Health > 0
end

local function partOf(c)
	if CFG.TargetPart == "Head" then
		return c:FindFirstChild("Head")
	end
	return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
end

-- Wall check: ray from the camera to the target. Ignores your own character,
-- the target, non-collidable parts and water.
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = true

local function clearPath(part, char)
	local origin = cam.CFrame.Position
	local filter = {char}
	if lp.Character then
		table.insert(filter, lp.Character)
	end
	rayParams.FilterDescendantsInstances = filter
	return workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

-- Visible if the aim part OR the body center can be seen
local function visible(char)
	local aim = partOf(char)
	local root = char:FindFirstChild("HumanoidRootPart")
	if aim and clearPath(aim, char) then return true end
	if root and root ~= aim and clearPath(root, char) then return true end
	return false
end

-- Is this player still a legal target right now?
local function valid(p)
	if not p or not alive(p) then return false end
	if CFG.TeamCheck and lp.Team and p.Team == lp.Team then return false end
	local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	local root = p.Character:FindFirstChild("HumanoidRootPart")
	if myRoot and root and (root.Position - myRoot.Position).Magnitude > CFG.MaxDist * 1.2 then
		return false
	end
	return true
end

local function candidates()
	local list = {}
	local myRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
	if not myRoot then return list end
	local center = cam.ViewportSize / 2

	for _, p in Players:GetPlayers() do
		if p ~= lp and alive(p) and not (CFG.TeamCheck and lp.Team and p.Team == lp.Team) then
			local part = partOf(p.Character)
			if part then
				local dist = (part.Position - myRoot.Position).Magnitude
				if dist <= CFG.MaxDist then
					local sp, onScreen = cam:WorldToViewportPoint(part.Position)
					local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
					local inRange = CFG.Mode == "Closest" or (onScreen and screenDist <= CFG.FOV)
					if inRange and (not CFG.WallCheck or visible(p.Character)) then
						table.insert(list, {
							p = p,
							score = CFG.Mode == "Closest" and dist or screenDist,
						})
					end
				end
			end
		end
	end

	table.sort(list, function(a, b) return a.score < b.score end)
	return list
end

